# Copy this to a .env file and fill in values as needed
# Minimal config for the remote Qwen3.5-9B-AWQ (vLLM) inference server

# --- LLM CONFIGURATION ---
# Default: local Ollama fallback (dev only)
USE_REMOTE_MODEL=0
MODEL_OLLAMA=qwen3.5:9b
OLLAMA_ENDPOINT=http://localhost:11434/api/chat

# Remote model server (Qwen3.5-9B-AWQ served with vLLM behind FastAPI + Ngrok)
# USE_REMOTE_MODEL=1
# LLM_API_URL=https://your-ngrok-url.ngrok-free.dev

# --- API KEYS (Only needed for Gemini/NVIDIA fallbacks) ---
# GEMINI_API_KEY=your_gemini_api_key_here
# NVIDIA_API_KEY=your_nvapi_key_here

# --- MLOps TRACKING (Optional) ---
# WANDB_API_KEY=your_wandb_api_key_here
